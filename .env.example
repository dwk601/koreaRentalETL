# Korean Rental ETL Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=korean_rental
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change_me_in_production

# Airflow Database (separate from app DB)
AIRFLOW_DB_HOST=localhost
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_in_production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Nominatim Geocoding
NOMINATIM_USER_AGENT=korean-rental-etl/0.1.0 (contact@example.com)
NOMINATIM_RATE_LIMIT_PER_SEC=1

# SMTP Notifications (for Airflow email alerts)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=etl@example.com
SMTP_TO=admin@example.com

# Scraping Configuration
DOWNLOAD_DELAY_SEC=2.0
CONCURRENT_REQUESTS=2
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/etl.log
