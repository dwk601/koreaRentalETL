# Korean Rental ETL Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=korean_rental
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=  # REQUIRED — set in Coolify / local .env, do not commit


# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Nominatim Geocoding
NOMINATIM_USER_AGENT=korean-rental-etl/0.1.0 (contact@example.com)
NOMINATIM_RATE_LIMIT_PER_SEC=1

# Optional SMTP failure/success notifications. Leave SMTP_TO/HOST empty to disable.
# Production email is optional. Leave SMTP_TO unset to disable notifications.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=resend
# SMTP_PASSWORD=  # Set in Coolify; never commit it.
# SMTP_FROM=ETL Alerts <alerts@yourverifieddomain.com>
# SMTP_TO=admin@yourverifieddomain.com

# Scraping Configuration
DOWNLOAD_DELAY_SEC=2.0
CONCURRENT_REQUESTS=2
MAX_RETRIES=3
EXTRACT_CUTOFF_DAYS=30

