# Korean Rental ETL Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=korean_rental
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=  # REQUIRED — set in Coolify / local .env, do not commit

# Airflow Database (separate from app DB)
AIRFLOW_DB_HOST=localhost
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=  # REQUIRED — set in Coolify / local .env, do not commit
AIRFLOW_ADMIN_PASSWORD=  # REQUIRED — set in Coolify / local .env, do not commit

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Nominatim Geocoding
NOMINATIM_USER_AGENT=korean-rental-etl/0.1.0 (contact@example.com)
NOMINATIM_RATE_LIMIT_PER_SEC=1

# Airflow Hostname (used by Traefik/Coolify router)
AIRFLOW_HOST=localhost

# SMTP / Email Notifications (using Resend in production, MailHog in dev)
# For local dev using MailHog, use:
# AIRFLOW__SMTP__SMTP_HOST=localhost
# AIRFLOW__SMTP__SMTP_PORT=1025
# AIRFLOW__SMTP__SMTP_STARTTLS=False
# AIRFLOW__SMTP__SMTP_SSL=False
# AIRFLOW__SMTP__SMTP_MAIL_FROM=etl@local
#
# For production using Resend, use:
AIRFLOW__SMTP__SMTP_HOST=smtp.resend.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=resend
AIRFLOW__SMTP__SMTP_PASSWORD=  # REQUIRED — set Resend API key (re_...) in Coolify / local .env, do not commit
AIRFLOW__SMTP__SMTP_MAIL_FROM=ETL Alerts <alerts@yourverifieddomain.com>
SMTP_TO=admin@yourverifieddomain.com

# Scraping Configuration
DOWNLOAD_DELAY_SEC=2.0
CONCURRENT_REQUESTS=2
MAX_RETRIES=3
EXTRACT_CUTOFF_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/etl.log
