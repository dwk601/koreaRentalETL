FROM postgis/postgis:16-3.4

# Bake schema migrations into the image so they ship with the deploy
# instead of relying on a host bind mount (Coolify removes the build
# checkout after the image is built, so a bind mount of ./sql/migrations
# would be empty at runtime).
#
# Postgres' default entrypoint executes /docker-entrypoint-initdb.d/*.sql
# on a new data volume. The Compose app-migrate service applies and records
# migrations for existing volumes before the scheduler starts.
COPY sql/migrations/ /docker-entrypoint-initdb.d/
