FROM apache/airflow:2.10.0-python3.11

USER root

# System dependencies:
#   - build-essential, libpq-dev: building psycopg / installing native deps
#   - lib*: runtime libs Chromium needs (used by Patchright/Playwright for the
#     stealth fetcher in missyusa).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        libatspi2.0-0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Create a project directory for copying the source code
WORKDIR /opt/airflow/project

# Copy package dependency manifests and source files
COPY --chown=airflow:root pyproject.toml uv.lock README.md ./
COPY --chown=airflow:root src/ ./src/

# Install the package locally using pip to put the cli executable on PATH
RUN pip install --no-cache-dir .

# Install Chromium browser binaries for Patchright (used by missyusa via
# StealthyFetcher). This downloads ~150MB to
# /home/airflow/.cache/ms-playwright. Without this step those scrapers fail
# at runtime with "Executable doesn't exist at chromium-XXXX/chrome-linux64".
RUN patchright install chromium

# Bake DAGs and source-config into the image so they ship with the deploy.
# Coolify removes the build checkout after image build, so a host bind mount
# of ./airflow/dags or ./config would be empty at runtime.
COPY --chown=airflow:root airflow/dags/ /opt/airflow/dags/
COPY --chown=airflow:root config/ /opt/airflow/project/config/

# Revert working directory to default Airflow home
WORKDIR /opt/airflow
